# Clé API Perplexity (https://www.perplexity.ai/account/api)
# Utilisée uniquement par le proxy Vite en `npm run dev` — jamais exposée au navigateur.
PERPLEXITY_API_KEY=

# Optionnel : 1 si antivirus / proxy d’entreprise casse le certificat TLS
# PERPLEXITY_INSECURE_TLS=1
# Utilisée par le proxy Vite pour les recommandations d’opportunité.
OPENAI_API_KEY=

# Optionnel — modèle Chat Completions (défaut : gpt-4o)
# OPENAI_MODEL=gpt-4o

# Optionnel : 1 si TLS cassé (même cas que Perplexity)
# OPENAI_INSECURE_TLS=1

# Supabase (auth) — Project Settings → API
# Relancer npm run dev après modification.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service role (serveur uniquement : Vite proxy + Netlify functions).
# Jamais VITE_ — ne pas committer la vraie clé.
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel : 1 si antivirus / proxy d’entreprise casse le certificat TLS
# côté Node (erreur « fetch failed » / UNABLE_TO_VERIFY_LEAF_SIGNATURE
# sur /api/hubspot/* ou /api/invite-user). Relancer npm run dev après.
# SUPABASE_INSECURE_TLS=1

# URL publique de l’app (redirect invitation). Prod = domaine Netlify.
# VITE_APP_URL=https://app.daily-business-review.com

# Resend — e-mails Auth via SMTP custom dans le dashboard Supabase
# (voir supabase/EMAIL_RESEND.md). Clé = password SMTP ; jamais exposée au navigateur.
# FROM_EMAIL / FROM_NAME : placeholders (valeurs réelles côté Netlify / .env.local).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# HubSpot — connecteur CRM (secrets PLATEFORME uniquement).
# Le client connecte son portail depuis Settings → CRM (OAuth), pas ici.
# Voir supabase/HUBSPOT.md.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Secret aléatoire long pour chiffrer access/refresh tokens en base (par org).
HUBSPOT_TOKEN_SECRET=
# Local :
HUBSPOT_REDIRECT_URI=http://localhost:5173/api/hubspot/oauth/callback
# Prod (Netlify) :
# HUBSPOT_REDIRECT_URI=https://app.daily-business-review.com/api/hubspot/oauth/callback
# Dev webhooks sans signature (ne pas activer en prod) :
# HUBSPOT_WEBHOOK_SKIP_VERIFY=1
