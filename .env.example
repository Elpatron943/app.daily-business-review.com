# Clé API Perplexity (https://www.perplexity.ai/account/api)
# Utilisée uniquement par le proxy Vite en `npm run dev` — jamais exposée au navigateur.
PERPLEXITY_API_KEY=

# Optionnel : 1 si antivirus / proxy d’entreprise casse le certificat TLS
# PERPLEXITY_INSECURE_TLS=1

# Clé API OpenAI / ChatGPT (https://platform.openai.com/api-keys)
# Utilisée par le proxy Vite pour les recommandations d’opportunité.
OPENAI_API_KEY=

# Optionnel — modèle Chat Completions (défaut : gpt-4o)
# OPENAI_MODEL=gpt-4o

# Optionnel : 1 si TLS cassé (même cas que Perplexity)
# OPENAI_INSECURE_TLS=1

# Supabase (auth) — Project Settings → API
# Relancer npm run dev après modification.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Resend — e-mails Auth via SMTP custom dans le dashboard Supabase
# (voir supabase/EMAIL_RESEND.md). Clé = password SMTP ; jamais exposée au navigateur.
# FROM_EMAIL / FROM_NAME : placeholders (valeurs réelles côté Netlify / .env.local).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
